{
  "name": "region-intel",
  "version": "3.3.1",
  "description": "Reusable regional civic intelligence: bounded acquisition, verification, alerts, search, RAG, analytics and publication",
  "type": "module",
  "scripts": {
    "scrape": "bun run src/scrape.ts",
    "verify": "bun run src/verify.ts",
    "export": "bun run src/export.ts",
    "all": "bun run src/scrape.ts && bun run src/verify.ts && bun run src/export.ts",
    "gui": "bun run src/gui/server.ts",
    "index": "bun run src/llm/index.ts index",
    "chat": "bun run src/llm/index.ts chat",
    "query": "bun run src/llm/index.ts query",
    "status": "bun run src/llm/index.ts status",
    "monitor": "bun run scripts/run-monitor.ts",
    "news": "bun run scripts/run-news.ts",
    "gov-meetings": "bun run scripts/run-meetings.ts",
    "youtube": "bun run scripts/run-youtube.ts",
    "events": "bun run src/events.ts",
    "curate": "bun run scripts/run-curation.ts",
    "alerts": "bun run scripts/run-alerts.ts",
    "alerts:tsunami": "bun run src/alerts/noaa_tsunami.ts",
    "alerts:earthquake": "bun run src/alerts/usgs_earthquake.ts",
    "alerts:weather": "bun run src/alerts/nws_weather.ts",
    "alerts:tides": "bun run src/alerts/noaa_tides.ts",
    "alerts:fishing": "bun run src/alerts/cdfw_fishing.ts",
    "alerts:airquality": "bun run src/alerts/epa_airnow.ts",
    "alerts:wildfire": "bun run src/alerts/calfire_wildfire.ts",
    "alerts:marine": "bun run src/alerts/ndbc_marine.ts",
    "alerts:marinezone": "bun run src/alerts/nws_marine.ts",
    "alerts:uscg": "bun run src/alerts/uscg_broadcasts.ts",
    "alerts:permits": "bun run src/alerts/permits.ts",
    "alerts:dredging": "bun run src/alerts/dredging.ts",
    "alerts:fuel": "bun run src/alerts/fuel.ts",
    "alerts:pacfin": "bun run src/alerts/pacfin.ts",
    "alerts:ais": "bun run src/alerts/ais.ts",
    "alerts:all": "bun run scripts/run-alerts.ts",
    "weekly-check": "bun run scripts/weekly-check.ts",
    "cron-setup": "bash scripts/cron-setup.sh",
    "coverage": "bun run scripts/run-coverage.ts",
    "readability": "bun run scripts/run-readability.ts",
    "report": "bun run src/monthly_report.ts",
    "insights": "bun run scripts/run-insights.ts",
    "analytics": "bun run scripts/run-analytics.ts",
    "manuscript:check": "bun run scripts/validate-manuscript.ts",
    "manuscript:hydrate": "bun run scripts/hydrate-manuscript.ts",
    "repair-output": "bun run scripts/repair-output.ts",
    "source-discovery": "bun run scripts/run-source-discovery.ts",
    "pages:export": "bun run scripts/export-pages.ts",
    "pages:seed": "bun run scripts/refresh-pages-data.ts",
    "pages:validate": "bun run scripts/validate-pages.ts",
    "validate": "bun run scripts/validate.ts",
    "typecheck": "bunx tsc --noEmit",
    "test:coverage": "bun test tests/ --coverage",
    "test:browser": "bun run scripts/browser-smoke.ts",
    "lifeos:bridge": "bun run scripts/lifeos-bridge.ts",
    "lifeos:daily": "bash scripts/lifeos-daily.sh",
    "geo:intel": "bun run src/geo.ts",
    "geo:observations": "bun run scripts/run-geo-observations.ts",
    "geo:sync-check": "bun run scripts/check-geo-sync.ts",
    "release:check": "bun run validate",
    "test": "bun test tests/",
    "test:typecheck": "bunx tsc --noEmit -p tsconfig.tests.json",
    "test:gui-journeys": "bun run tests/gui-journeys.browser.ts",
    "test:llm-native": "bun run tests/llm-native.acceptance.ts",
    "rag:benchmark": "bun run scripts/rag-benchmark.ts",
    "meeting-documents": "bun run scripts/fetch-meeting-documents.ts",
    "docs:generate": "bun run scripts/generate-docs.ts --write",
    "docs:check": "bun run scripts/generate-docs.ts --check",
    "source:coverage": "bun run scripts/source-coverage.ts",
    "test:gui-readers": "bun run tests/gui-readers.browser.ts",
    "test:pages-readers": "bun run tests/pages-readers.browser.ts",
    "civic:profile": "bun run src/civic_profile.ts",
    "region:config": "bun run src/region_config.ts",
    "region": "bun run src/regional_cli.ts",
    "corpus:check": "bun run src/regional_cli.ts corpus:check",
    "corpus:promote": "bun run src/regional_cli.ts corpus:promote",
    "manuscript:render": "bun run src/regional_cli.ts manuscript:render",
    "manuscript:validate-render": "bun run src/regional_cli.ts manuscript:validate-render",
    "manuscript:bundle": "bun run src/regional_cli.ts manuscript:bundle"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.11",
    "cheerio": "1.2.0",
    "chromadb": "3.3.3",
    "playwright": "1.58.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "bun-types": "^1.2.4"
  },
  "license": "CC-BY-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/docxology/region-intel.git"
  },
  "exports": {
    ".": "./src/deployment.ts",
    "./cli": "./src/regional_cli.ts",
    "./deployment": "./src/deployment.ts",
    "./surface": "./src/regional_surface.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "region-intel": "./src/regional_cli.ts"
  }
}
